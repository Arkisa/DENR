# Copy this file to ".env" and edit the values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/denr_slf
FRONTEND_URL=http://localhost:5173

# Optional: real email sending. If SMTP_HOST is empty, the verification
# link is printed in the backend terminal instead (good for demos).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@denr-emb.local
